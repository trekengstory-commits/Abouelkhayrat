# ───────── متغيرات البيئة — انسخ إلى .env.local محليًا وإلى Vercel → Settings → Environment Variables ─────────

# قاعدة بيانات Turso (إلزامي)
# أنشئ قاعدة مجانية: turso db create <name> ثم:
#   turso db show <name> --url          → TURSO_DATABASE_URL
#   turso db tokens create <name>       → TURSO_AUTH_TOKEN
TURSO_DATABASE_URL=libsql://<db-name>-<org>.turso.io
TURSO_AUTH_TOKEN=<turso-token-with-write-access>

# خدمة دمج الفيديو Video Merger API v2 (مطلوبة لأداة merge_videos)
MERGER_API_BASE=https://<your-merger-service>

# ───────── اختياري ─────────

# مفتاح أولي يُزرع تلقائيًا في قاعدة البيانات مرة واحدة عند فراغ جدول المفاتيح
# (بديل: أضف المفاتيح من واجهة الإدارة بعد النشر)
# KIE_API_KEY=
# COMETAPI_API_KEY=

# حماية /mcp بـ Bearer token — إن ضُبط يطلب العميلون Authorization header
# MCP_ACCESS_TOKEN=

# تجاوز أسماء الموديلات إن تغيّرت لدى المزودين
# KIE_IMAGE_MODEL=gpt-image-2-6/flare-text-to-image
# KIE_VIDEO_MODEL=grok-imagine-video-1-5-preview
# COMETAPI_IMAGE_MODEL=gpt-image-2.6-flare-text-to-image
# COMETAPI_VIDEO_MODEL=grok-imagine-video-1-5-preview

# تجاوز عنوان CometAPI الأساسي إن لزم
# COMETAPI_BASE_URL=https://api.cometapi.com
